{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Read",
      "Glob",
      "Grep",
      "LS"
    ],
    "ask": [
      "Write",
      "Edit",
      "MultiEdit",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cargo fmt || true"
          }
        ]
      }
    ]
  }
}
